// WARNING: The user explicitly requested to allow global read and write for all collections.
// This is extremely insecure and should NOT be used in a real production environment.
// The user stated they will handle security at the UI level.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global allow read/write for all collections
    match /{document=**} {
      allow read, write: if true;
    }

  }
}
